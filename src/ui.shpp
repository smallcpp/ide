#ifndef IDE_UI
#define IDE_UI

/* GTK window for the editor. Headless tests do not
 * include this file. The menu row is the first child
 * of the window because the wrapper has no title-bar
 * setter.
 */
#include "session.shpp"
#include "syntax.shpp"
#include <exceptions>
#include <gtk>

using namespace Gtk;

enum {
    IDE_PAGES = 32,
    IDE_ROWS = 200
};

class PageRef {
public:
    long index;
};

class IdePage {
public:
    TextBuffer *buffer;
    TextView *view;
    ScrolledWindow *scroll;
    int tags;
};

class Ui {
public:
    Ui(Session *session);
    Session *editor(void);
    int start(void);
    void show_main(void);
    void refresh(void);
    void handle(int code);
    void on_menu(const char *label);
    void open_path(const char *path);
    void open_at(const char *path, long line);
    void save_path(const char *path);
    void use_folder(const char *path);
    void choice(int response);
    void goto_ok(void);
    void toggled_hidden(bool value);
    void changed(long index);
    void moved(long index, long line, long offset);
    void switched(long index);
    void tick(void);
    void find_clicked(void);
    void replace_clicked(void);
    void replace_all_clicked(void);
    void apply_prefs(void);
    void configure_ok(void);
    int applying;
    Entry *gotoEntry;
    Entry *findEntry;
    Entry *replaceEntry;
    Entry *folderEntry;
    Entry *lspEntry;
    Entry *excludeEntry;
private:
    Session *state;
    Application *app;
    Window *mainWindow;
    MenuButton *fileMenu;
    MenuButton *editMenu;
    MenuButton *searchMenu;
    MenuButton *viewMenu;
    MenuButton *projectMenu;
    MenuButton *buildMenu;
    MenuButton *helpMenu;
    Notebook *book;
    Notebook *sideBook;
    Notebook *messageBook;
    ColumnView *projectList;
    ColumnView *fileList;
    ColumnView *searchList;
    ColumnView *diagList;
    ColumnView *buildList;
    TextBuffer *buildBuffer;
    TextView *buildView;
    Label *status;
    Paned *split;
    Paned *vsplit;
    Box *sideBox;
    IdePage pages[IDE_PAGES];
    PageRef refs[IDE_PAGES];
    long pageCount;
    String *rows[IDE_ROWS];
    String *recentText[20];
    int folderMode;
    int choiceMode;
    String *pendingPath;
    Window *findWindow;
    Window *aboutWindow;
    Window *prefWindow;
    Dialog *choiceDialog;
    Dialog *gotoDialog;
    Dialog *folderDialog;
    Dialog *excludeDialog;
    FileDialog *files;
    SpinButton *fontSize;
    SpinButton *tabWidth;
    CheckButton *spacesCheck;
    CheckButton *bracketsCheck;
    CheckButton *indentCheck;
    void build(void);
    void fill_file_menu(void);
    void fill_menus(void);
    void fill_one(
            MenuButton *button,
            const char **ids,
            long count);
    const char *menu_label(const char *id);
    void fill_messages(void);
    void reveal(long line);
    void add_page(long index);
    void rebuild(void);
    void push_active(void);
    void fill_lists(void);
    void highlight(long index);
    void show_find(void);
    void show_about(void);
    void show_prefs(void);
    void show_choice(const char *title, int mode);
    void show_goto(void);
    void show_folder(int mode);
    void show_exclude(void);
    void paint_status(void);
};

#endif
