#ifndef IDE_UI
#define IDE_UI

/* GTK window for the editor. Headless tests do not
 * include this file. The menu row is the first child
 * of the window because the wrapper has no title-bar
 * setter.
 */
#include "session.scpp"
#include "syntax.scpp"
#include <exceptions>
#include <gtk>

using namespace Gtk;

enum {
    IDE_PAGES = 32,
    IDE_ROWS = 200
};

class PageRef {
public:
    long index;
};

class IdePage {
public:
    TextBuffer *buffer;
    TextView *view;
    ScrolledWindow *scroll;
    int tags;
};

class Ui {
public:
    Ui(Session *session);
    Session *editor(void);
    int start(void);
    void show_main(void);
    void refresh(void);
    void handle(int code);
    void on_menu(const char *label);
    void open_path(const char *path);
    void save_path(const char *path);
    void use_folder(const char *path);
    void choice(int response);
    void goto_ok(void);
    void toggled_hidden(bool value);
    void changed(long index);
    void moved(long index, long line, long offset);
    void switched(long index);
    void tick(void);
    void find_clicked(void);
    void replace_clicked(void);
    void replace_all_clicked(void);
    void apply_prefs(void);
    void configure_ok(void);
    int applying;
    Entry *gotoEntry;
    Entry *findEntry;
    Entry *replaceEntry;
    Entry *folderEntry;
    Entry *lspEntry;
    Entry *excludeEntry;
private:
    Session *state;
    Application *app;
    Window *mainWindow;
    MenuButton *fileMenu;
    Notebook *book;
    Notebook *sideBook;
    ColumnView *projectList;
    ColumnView *fileList;
    Label *status;
    Paned *split;
    Box *sideBox;
    IdePage pages[IDE_PAGES];
    PageRef refs[IDE_PAGES];
    long pageCount;
    String *rows[IDE_ROWS];
    String *recentText[20];
    int folderMode;
    int choiceMode;
    String *pendingPath;
    Window *findWindow;
    Window *aboutWindow;
    Window *prefWindow;
    Dialog *choiceDialog;
    Dialog *gotoDialog;
    Dialog *folderDialog;
    Dialog *excludeDialog;
    FileDialog *files;
    SpinButton *fontSize;
    SpinButton *tabWidth;
    CheckButton *spacesCheck;
    CheckButton *bracketsCheck;
    CheckButton *indentCheck;
    void build(void);
    void fill_file_menu(void);
    void add_page(long index);
    void rebuild(void);
    void push_active(void);
    void fill_lists(void);
    void highlight(long index);
    void show_find(void);
    void show_about(void);
    void show_prefs(void);
    void show_choice(const char *title, int mode);
    void show_goto(void);
    void show_folder(int mode);
    void show_exclude(void);
    void paint_status(void);
};

Ui *ideUi;
Application *uiApp;
int uiLive;
int uiTicker;

void *ui_ticker(void *arg);

void ui_byte_pos(
        const char *text,
        long byte,
        long *line,
        long *col) {
    long i;

    *line = 0;
    *col = 0;
    if (text == nullptr)
        return;
    i = 0;
    while (text[i] != 0 && i < byte) {
        if (text[i] == '\n') {
            *line = *line + 1;
            *col = 0;
        }
        else
            *col = *col + 1;
        i = i + 1;
    }
}

void ui_activate(void *data) {
    pthread_t thread;

    (void)data;
    uiLive = 1;
    if (uiTicker == 0) {
        uiTicker = 1;
        pthread_create(&thread, nullptr, ui_ticker, nullptr);
    }
    ideUi->show_main();
}

void ui_menu(void *data, const char *label) {
    (void)data;
    ideUi->on_menu(label);
}

void ui_opened(void *data, const char *path) {
    (void)data;
    ideUi->open_path(path);
}

void ui_saved(void *data, const char *path) {
    (void)data;
    ideUi->save_path(path);
}

void ui_choice_response(void *data, int response) {
    (void)data;
    ideUi->choice(response);
}

void ui_goto_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->goto_ok();
}

void ui_folder_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->use_folder(ideUi->folderEntry->text());
}

void ui_exclude_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->configure_ok();
}

bool ui_close(void *data) {
    int code;

    (void)data;
    code = ideUi->editor()->quit();
    if (ideUi->editor()->quit_ready() == 1) {
        uiLive = 0;
        return false;
    }
    ideUi->handle(code);
    return true;
}

void ui_hidden(void *data, bool value) {
    (void)data;
    ideUi->toggled_hidden(value);
}

void ui_hide_side(void *data) {
    (void)data;
    ideUi->editor()->set_view_flag(
            "editor.show_project_manager",
            false);
    ideUi->refresh();
}

void ui_refresh_tree(void *data) {
    (void)data;
    ideUi->editor()->explorer()->refresh();
    ideUi->refresh();
}

void ui_changed(void *data) {
    PageRef *ref;

    ref = (PageRef *)data;
    ideUi->changed(ref->index);
}

void ui_moved(void *data, long line, long offset) {
    PageRef *ref;

    ref = (PageRef *)data;
    ideUi->moved(ref->index, line, offset);
}

void ui_switched(void *data, long index) {
    (void)data;
    ideUi->switched(index);
}

void ui_project_row(void *data, long index) {
    ExplorerEntry *row;

    (void)data;
    if (index < 0 || index >= ideUi->editor()->explorer()->count())
        return;
    row = ideUi->editor()->explorer()->at(index);
    if (row->kind == ENTRY_DIR)
        ideUi->editor()->explorer()->toggle(index);
    else if (row->kind == ENTRY_FILE || row->kind == ENTRY_LINK)
        ideUi->open_path(row->full->c_str());
    else
        ideUi->refresh();
}

void ui_tick(void *data) {
    (void)data;
    if (ideUi != nullptr)
        ideUi->tick();
}

void *ui_ticker(void *arg) {
    struct timespec delay;

    (void)arg;
    delay.tv_sec = 3;
    delay.tv_nsec = 0;
    while (uiLive == 1) {
        nanosleep(&delay, nullptr);
        if (uiLive == 1 && uiApp != nullptr)
            uiApp->post(ui_tick, nullptr);
    }
    return nullptr;
}

void ui_find(void *data) {
    (void)data;
    ideUi->find_clicked();
}

void ui_replace(void *data) {
    (void)data;
    ideUi->replace_clicked();
}

void ui_replace_all(void *data) {
    (void)data;
    ideUi->replace_all_clicked();
}

void ui_apply_prefs(void *data) {
    (void)data;
    ideUi->apply_prefs();
}

Ui::Ui(Session *session) {
    long i;

    state = session;
    applying = 0;
    pageCount = 0;
    folderMode = 0;
    choiceMode = 0;
    pendingPath = new String();
    fileMenu = nullptr;
    i = 0;
    while (i < IDE_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].tags = 0;
        refs[i].index = i;
        i = i + 1;
    }
    i = 0;
    while (i < 20) {
        recentText[i] = new String();
        i = i + 1;
    }
    i = 0;
    while (i < IDE_ROWS) {
        rows[i] = new String();
        i = i + 1;
    }
    ideUi = this;
    uiLive = 0;
    uiTicker = 0;
}

Session *Ui::editor(void) {
    return state;
}

void Ui::fill_file_menu(void) {
    const char *fileLabels[40];
    long n;
    long i;

    if (fileMenu == nullptr)
        return;
    n = 0;
    fileLabels[n] = "New";
    n = n + 1;
    fileLabels[n] = "Open";
    n = n + 1;
    fileLabels[n] = "Save";
    n = n + 1;
    fileLabels[n] = "Save As";
    n = n + 1;
    fileLabels[n] = "Save All";
    n = n + 1;
    fileLabels[n] = "Reload";
    n = n + 1;
    fileLabels[n] = "Close";
    n = n + 1;
    fileLabels[n] = "Close All";
    n = n + 1;
    fileLabels[n] = "Open Folder";
    n = n + 1;
    i = 0;
    while (i < state->recent_count() && i < 20 && n < 38) {
        recentText[i]->truncate(0, recentText[i]->size());
        recentText[i]->append("Recent: ");
        recentText[i]->append(state->recent_at(i));
        fileLabels[n] = recentText[i]->c_str();
        n = n + 1;
        i = i + 1;
    }
    fileLabels[n] = "Quit";
    n = n + 1;
    fileMenu->set_menu(fileLabels, n, ui_menu, nullptr);
}

void Ui::build(void) {
    HeaderBar *bar;
    MenuButton *editMenu;
    MenuButton *viewMenu;
    MenuButton *projectMenu;
    MenuButton *helpMenu;
    const char *editLabels[20];
    const char *viewLabels[8];
    const char *projectLabels[8];
    const char *helpLabels[4];
    Box *outer;
    Box *editorBox;
    Button *refreshButton;
    Button *hideButton;
    CheckButton *hidden;
    Box *findBox;
    Button *findButton;
    Button *replaceButton;
    Button *allButton;
    Box *prefBox;
    Button *applyButton;
    String *aboutText;
    Label *aboutLabel;
    long width;
    long height;
    long side;

    app = new Application("org.smallcpp.Ide");
    uiApp = app;
    mainWindow = new Window("ide");
    width = 980;
    height = 720;
    side = 300;
    if (state->project()->is_project() == 1) {
        width = state->project()->window_width();
        height = state->project()->window_height();
        side = state->project()->side_width();
    }
    mainWindow->set_default_size(width, height);
    mainWindow->on_close_request(ui_close, nullptr);
    bar = new HeaderBar();
    bar->set_show_title_buttons(false);
    bar->set_title("ide");
    fileMenu = new MenuButton("File");
    editMenu = new MenuButton("Edit");
    viewMenu = new MenuButton("View");
    projectMenu = new MenuButton("Project");
    helpMenu = new MenuButton("Help");
    fill_file_menu();
    editLabels[0] = "Undo";
    editLabels[1] = "Redo";
    editLabels[2] = "Cut";
    editLabels[3] = "Copy";
    editLabels[4] = "Paste";
    editLabels[5] = "Select All";
    editLabels[6] = "Find";
    editLabels[7] = "Replace";
    editLabels[8] = "Find in Project";
    editLabels[9] = "Go to Line";
    editLabels[10] = "Comment";
    editLabels[11] = "Block Comment";
    editLabels[12] = "Indent";
    editLabels[13] = "Outdent";
    editLabels[14] = "Strip Trailing Spaces";
    editLabels[15] = "Insert at Column";
    editLabels[16] = "Delete at Column";
    editLabels[17] = "Insert Date";
    editLabels[18] = "Toggle Debug";
    editMenu->set_menu(editLabels, 19, ui_menu, nullptr);
    viewLabels[0] = "Line Numbers";
    viewLabels[1] = "Whitespace";
    viewLabels[2] = "Line Ends";
    viewLabels[3] = "Indent Markers";
    viewLabels[4] = "Project Manager";
    viewMenu->set_menu(viewLabels, 5, ui_menu, nullptr);
    projectLabels[0] = "New Project";
    projectLabels[1] = "Open Project";
    projectLabels[2] = "Close Project";
    projectLabels[3] = "Save Project";
    projectLabels[4] = "Save Project As";
    projectLabels[5] = "Delete Project";
    projectLabels[6] = "Configure Exclusions";
    projectMenu->set_menu(projectLabels, 7, ui_menu, nullptr);
    helpLabels[0] = "Preferences";
    helpLabels[1] = "About";
    helpMenu->set_menu(helpLabels, 2, ui_menu, nullptr);
    bar->pack_start((Widget *)fileMenu);
    bar->pack_start((Widget *)editMenu);
    bar->pack_start((Widget *)viewMenu);
    bar->pack_start((Widget *)projectMenu);
    bar->pack_end((Widget *)helpMenu);
    outer = new Box(GTK_VERTICAL, 0);
    outer->append((Widget *)bar);
    split = new Paned(GTK_HORIZONTAL);
    sideBox = new Box(GTK_VERTICAL, 4);
    sideBox->set_width_request(160);
    sideBook = new Notebook();
