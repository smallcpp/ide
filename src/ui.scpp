    projectList->append_column("Project");
    projectList->on_activate(ui_project_row, nullptr);
    fileList = new ColumnView();
    fileList->append_column("Files");
    fileList->on_activate(ui_project_row, nullptr);
    sideBook->append_page((Widget *)projectList, "Project");
    sideBook->append_page((Widget *)fileList, "Files");
