void Ui::fill_one(
        MenuButton *button,
        const char **ids,
        long count) {
    const char *labels[40];
    char *kept[40];
    char *labelCopy;
    char *bindCopy;
    long i;

    if (button == nullptr || count < 0 || count > 40)
        return;
    i = 0;
    while (i < count) {
        labelCopy = ui_keep(menu_label(ids[i]));
        bindCopy = ui_keep(
                state->settings()->binding(ids[i]));
        kept[i] = ui_menu_row(
                ids[i],
                labelCopy,
                bindCopy);
        ui_free(labelCopy);
        ui_free(bindCopy);
        if (kept[i] == nullptr)
            labels[i] = ids[i];
        else
            labels[i] = kept[i];
        i = i + 1;
    }
    button->set_menu(labels, count, ui_menu, nullptr);
    i = 0;
    while (i < count) {
        ui_free(kept[i]);
        i = i + 1;
    }
}

void Ui::fill_file_menu(void) {
    const char *fileIds[9];
    const char *labels[40];
    char *kept[40];
    char *labelCopy;
    char *bindCopy;
    char *pathCopy;
    long n;
    long i;

    if (fileMenu == nullptr)
        return;
    fileIds[0] = "new";
    fileIds[1] = "open";
    fileIds[2] = "save";
    fileIds[3] = "save-as";
    fileIds[4] = "save-all";
    fileIds[5] = "reload";
    fileIds[6] = "close";
    fileIds[7] = "close-all";
    fileIds[8] = "open-folder";
    n = 0;
    i = 0;
    while (i < 9) {
        labelCopy = ui_keep(menu_label(fileIds[i]));
        bindCopy = ui_keep(
                state->settings()->binding(fileIds[i]));
        kept[n] = ui_menu_row(
                fileIds[i],
                labelCopy,
                bindCopy);
        ui_free(labelCopy);
        ui_free(bindCopy);
        if (kept[n] == nullptr)
            labels[n] = fileIds[i];
        else
            labels[n] = kept[n];
        n = n + 1;
        i = i + 1;
    }
    i = 0;
    while (i < state->recent_count() && i < 20 && n < 38) {
        pathCopy = ui_keep(state->recent_at(i));
        kept[n] = ui_menu_row("recent", pathCopy, "");
        ui_free(pathCopy);
        if (kept[n] == nullptr)
            labels[n] = "recent";
        else
            labels[n] = kept[n];
        n = n + 1;
        i = i + 1;
    }
    labelCopy = ui_keep(menu_label("quit"));
    bindCopy = ui_keep(state->settings()->binding("quit"));
    kept[n] = ui_menu_row("quit", labelCopy, bindCopy);
    ui_free(labelCopy);
    ui_free(bindCopy);
    if (kept[n] == nullptr)
        labels[n] = "quit";
    else
        labels[n] = kept[n];
    n = n + 1;
    fileMenu->set_menu(labels, n, ui_menu, nullptr);
    i = 0;
    while (i < n) {
        ui_free(kept[i]);
        i = i + 1;
    }
}

void Ui::fill_menus(void) {
    const char *editIds[15];
    const char *searchIds[5];
    const char *viewIds[6];
    const char *projectIds[7];
    const char *buildIds[3];
    const char *helpIds[2];

    fill_file_menu();
    editIds[0] = "undo";
    editIds[1] = "redo";
    editIds[2] = "cut";
    editIds[3] = "copy";
    editIds[4] = "paste";
    editIds[5] = "select-all";
    editIds[6] = "comment";
    editIds[7] = "block-comment";
    editIds[8] = "indent";
    editIds[9] = "outdent";
    editIds[10] = "strip-trailing-spaces";
    editIds[11] = "insert-column";
    editIds[12] = "delete-column";
    editIds[13] = "plugin-time";
    editIds[14] = "plugin-debug";
    fill_one(editMenu, editIds, 15);
    searchIds[0] = "find";
    searchIds[1] = "replace";
    searchIds[2] = "find-project";
    searchIds[3] = "goto-line";
    searchIds[4] = "focus-search";
    fill_one(searchMenu, searchIds, 5);
    viewIds[0] = "show-line-numbers";
    viewIds[1] = "show-whitespace";
    viewIds[2] = "show-line-ends";
    viewIds[3] = "show-indent-markers";
    viewIds[4] = "show-project-manager";
    viewIds[5] = "focus-messages";
    fill_one(viewMenu, viewIds, 6);
    projectIds[0] = "project-new";
    projectIds[1] = "project-open";
    projectIds[2] = "project-close";
    projectIds[3] = "project-save";
    projectIds[4] = "project-save-as";
    projectIds[5] = "project-delete";
    projectIds[6] = "project-configure";
    fill_one(projectMenu, projectIds, 7);
    buildIds[0] = "build-compile";
    buildIds[1] = "build-build";
    buildIds[2] = "build-run";
    fill_one(buildMenu, buildIds, 3);
    helpIds[0] = "preferences";
    helpIds[1] = "about";
    fill_one(helpMenu, helpIds, 2);
}

void Ui::build(void) {
    HeaderBar *bar;
    Box *outer;
    Box *buildBox;
    ScrolledWindow *searchScroll;
    ScrolledWindow *diagScroll;
    ScrolledWindow *buildScroll;
    ScrolledWindow *buildTextScroll;
    Button *refreshButton;
    Button *hideButton;
    CheckButton *hidden;
    Box *findBox;
    Button *findButton;
    Button *replaceButton;
    Button *allButton;
    Box *prefBox;
    Button *applyButton;
    String *aboutText;
    Label *aboutLabel;
    long width;
    long height;
    long side;

    app = new Application("org.smallcpp.Ide");
    uiApp = app;
    mainWindow = new Window("ide");
    width = 980;
    height = 720;
    side = 300;
    if (state->project()->is_project() == 1) {
        width = state->project()->window_width();
        height = state->project()->window_height();
        side = state->project()->side_width();
    }
    mainWindow->set_default_size(width, height);
    mainWindow->on_close_request(ui_close, nullptr);
    bar = new HeaderBar();
    bar->set_show_title_buttons(false);
    bar->set_title("ide");
    fileMenu = new MenuButton("File");
    editMenu = new MenuButton("Edit");
    searchMenu = new MenuButton("Search");
    viewMenu = new MenuButton("View");
    projectMenu = new MenuButton("Project");
    buildMenu = new MenuButton("Build");
    helpMenu = new MenuButton("Help");
    bar->pack_start((Widget *)fileMenu);
    bar->pack_start((Widget *)editMenu);
    bar->pack_start((Widget *)searchMenu);
    bar->pack_start((Widget *)viewMenu);
    bar->pack_start((Widget *)projectMenu);
    bar->pack_start((Widget *)buildMenu);
    bar->pack_end((Widget *)helpMenu);
    outer = new Box(GTK_VERTICAL, 0);
    outer->append((Widget *)bar);
    split = new Paned(GTK_HORIZONTAL);
    sideBox = new Box(GTK_VERTICAL, 4);
    sideBox->set_width_request(160);
    sideBook = new Notebook();
    projectList = new ColumnView();
    projectList->append_column("Project");
    projectList->on_activate(ui_project_row, nullptr);
    fileList = new ColumnView();
    fileList->append_column("Files");
    fileList->on_activate(ui_project_row, nullptr);
    sideBook->append_page((Widget *)projectList, "Project");
    sideBook->append_page((Widget *)fileList, "Files");
    refreshButton = new Button("Refresh");
    refreshButton->on_clicked(ui_refresh_tree, nullptr);
    hidden = new CheckButton("Show Hidden");
    hidden->on_toggled(ui_hidden, nullptr);
    hideButton = new Button("Hide Sidebar");
    hideButton->on_clicked(ui_hide_side, nullptr);
    sideBox->append((Widget *)sideBook);
    sideBox->append((Widget *)refreshButton);
    sideBox->append((Widget *)hidden);
    sideBox->append((Widget *)hideButton);
    book = new Notebook();
    book->on_switch_page(ui_switched, nullptr);
    book->set_v_expand(true);
    status = new Label("ide");
    split->set_start_child((Widget *)sideBox);
    split->set_end_child((Widget *)book);
    split->set_position(side);
    split->set_v_expand(true);
    messageBook = new Notebook();
    messageBook->set_v_expand(true);
    searchList = new ColumnView();
    searchList->append_column("Path");
    searchList->append_column("Line");
    searchList->append_column("Text");
    searchList->on_activate(ui_search_row, nullptr);
    diagList = new ColumnView();
    diagList->append_column("Path");
    diagList->append_column("Line");
    diagList->append_column("Message");
    diagList->on_activate(ui_diag_row, nullptr);
    buildList = new ColumnView();
    buildList->append_column("Path");
    buildList->append_column("Line");
    buildList->append_column("Text");
    buildList->on_activate(ui_build_row, nullptr);
    buildBuffer = new TextBuffer();
    buildView = new TextView(buildBuffer);
    buildView->set_monospace(true);
    buildView->set_editable(false);
    searchScroll = new ScrolledWindow();
    searchScroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    searchScroll->set_child((Widget *)searchList);
    searchScroll->set_v_expand(true);
    diagScroll = new ScrolledWindow();
    diagScroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    diagScroll->set_child((Widget *)diagList);
    diagScroll->set_v_expand(true);
    buildScroll = new ScrolledWindow();
    buildScroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    buildScroll->set_child((Widget *)buildList);
    buildScroll->set_v_expand(true);
    buildTextScroll = new ScrolledWindow();
    buildTextScroll->set_policy(
            GTK_POLICY_AUTOMATIC,
            GTK_POLICY_AUTOMATIC);
    buildTextScroll->set_child((Widget *)buildView);
    buildTextScroll->set_v_expand(true);
    buildBox = new Box(GTK_VERTICAL, 0);
    buildBox->set_v_expand(true);
    buildBox->append((Widget *)buildScroll);
    buildBox->append((Widget *)buildTextScroll);
    messageBook->append_page((Widget *)searchScroll, "Search");
    messageBook->append_page((Widget *)diagScroll, "Diagnostics");
    messageBook->append_page((Widget *)buildBox, "Build");
    vsplit = new Paned(GTK_VERTICAL);
    vsplit->set_start_child((Widget *)split);
    vsplit->set_end_child((Widget *)messageBook);
    vsplit->set_position(480);
    vsplit->set_v_expand(true);
    outer->append((Widget *)vsplit);
    outer->append((Widget *)status);
    mainWindow->set_child((Widget *)outer);
    files = new FileDialog();
    choiceDialog = new Dialog("Confirm");
    choiceDialog->add_button("Save", IDE_SAVE);
    choiceDialog->add_button("Discard", IDE_DISCARD);
    choiceDialog->add_button("Cancel", IDE_CANCEL);
    choiceDialog->add_button("Continue", IDE_CONTINUE);
    choiceDialog->on_response(ui_choice_response, nullptr);
    gotoDialog = new Dialog("Go to Line");
    gotoEntry = new Entry("");
    gotoDialog->set_content((Widget *)gotoEntry);
    gotoDialog->add_button("Go", 1);
    gotoDialog->add_button("Cancel", IDE_CANCEL);
    gotoDialog->on_response(ui_goto_response, nullptr);
    folderDialog = new Dialog("Folder");
    folderEntry = new Entry("");
    folderDialog->set_content((Widget *)folderEntry);
    folderDialog->add_button("Use Folder", 1);
    folderDialog->add_button("Cancel", IDE_CANCEL);
    folderDialog->on_response(ui_folder_response, nullptr);
    excludeDialog = new Dialog("Exclusions");
    excludeEntry = new Entry("");
    excludeDialog->set_content((Widget *)excludeEntry);
    excludeDialog->add_button("Apply", 1);
    excludeDialog->add_button("Cancel", IDE_CANCEL);
    excludeDialog->on_response(ui_exclude_response, nullptr);
    findWindow = new Window("Find");
    findBox = new Box(GTK_VERTICAL, 4);
    findEntry = new Entry("");
    replaceEntry = new Entry("");
    findButton = new Button("Find Next");
    replaceButton = new Button("Replace");
    allButton = new Button("Replace All");
    findButton->on_clicked(ui_find, nullptr);
    replaceButton->on_clicked(ui_replace, nullptr);
    allButton->on_clicked(ui_replace_all, nullptr);
    findBox->append((Widget *)findEntry);
    findBox->append((Widget *)replaceEntry);
    findBox->append((Widget *)findButton);
    findBox->append((Widget *)replaceButton);
    findBox->append((Widget *)allButton);
    findWindow->set_child((Widget *)findBox);
    aboutWindow = new Window("About ide");
    aboutText = new String();
    aboutText->append("ide 0.0.1\n");
    aboutText->append("A smallcpp text editor.\n");
    aboutText->append("https://github.com/smallcpp/ide\n");
    aboutText->append("https://github.com/smallcpp/smallcpp");
    aboutLabel = new Label(aboutText->c_str());
    aboutWindow->set_child((Widget *)aboutLabel);
    prefWindow = new Window("Preferences");
    prefBox = new Box(GTK_VERTICAL, 4);
    fontSize = new SpinButton(6, 72, 12);
    tabWidth = new SpinButton(1, 16, 4);
    spacesCheck = new CheckButton("Insert spaces");
    bracketsCheck = new CheckButton("Auto-close brackets");
    indentCheck = new CheckButton("Auto-indent");
    lspEntry = new Entry("");
    applyButton = new Button("Apply");
    applyButton->on_clicked(ui_apply_prefs, nullptr);
    prefBox->append((Widget *)fontSize);
    prefBox->append((Widget *)tabWidth);
    prefBox->append((Widget *)spacesCheck);
    prefBox->append((Widget *)bracketsCheck);
    prefBox->append((Widget *)indentCheck);
    prefBox->append((Widget *)lspEntry);
    prefBox->append((Widget *)applyButton);
    prefWindow->set_child((Widget *)prefBox);
    fill_menus();
}

void Ui::add_page(long index) {
    Document *doc;
    char title[256];
    ScrolledWindow *scroll;

    doc = state->at(index);
    if (doc == nullptr)
        return;
    pages[index].buffer = new TextBuffer();
    pages[index].view = new TextView(pages[index].buffer);
    pages[index].view->set_monospace(true);
    pages[index].view->set_editable(true);
    scroll = new ScrolledWindow();
    scroll->set_policy(GTK_POLICY_AUTOMATIC, GTK_POLICY_AUTOMATIC);
    scroll->set_child((Widget *)pages[index].view);
    pages[index].scroll = scroll;
    pages[index].tags = 0;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    pages[index].buffer->on_changed(ui_changed, (void *)&refs[index]);
    pages[index].view->on_move_cursor(ui_moved, (void *)&refs[index]);
    if (doc->buffer()->dirty() == true)
        snprintf(title, 256, "* %s", doc->title());
    else
        snprintf(title, 256, "%s", doc->title());
    book->append_page((Widget *)scroll, title);
    pageCount = pageCount + 1;
    highlight(index);
}

void Ui::rebuild(void) {
    long i;
    long n;

    while (pageCount > 0) {
        book->remove_page(0);
        pageCount = pageCount - 1;
    }
    n = state->count();
    if (n > IDE_PAGES)
        n = IDE_PAGES;
    i = 0;
    while (i < n) {
        add_page(i);
        i = i + 1;
    }
    if (pageCount > 0 && state->index() < pageCount)
        book->set_current_page(state->index());
}

void Ui::push_active(void) {
    long index;
    Document *doc;

    index = state->index();
    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->active();
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    if (text_same(
                pages[index].buffer->get_text(),
                doc->buffer()->text()) == 1)
        return;
    applying = 1;
    pages[index].buffer->set_text(doc->buffer()->text());
    applying = 0;
    highlight(index);
}

void Ui::fill_lists(void) {
    const char *cells[1];
    long i;
    long depth;
    Explorer *tree;
    ExplorerEntry *row;

    tree = state->explorer();
    if (state->project()->root()[0] != 0)
        tree->set_root(state->project()->root());
    if (state->project()->is_project() == 1)
        tree->use_project(state->project());
    tree->refresh();
    projectList->clear_rows();
    fileList->clear_rows();
    i = 0;
    while (i < tree->count() && i < IDE_ROWS) {
        row = tree->at(i);
        if (rows[i] == nullptr)
            rows[i] = new String();
        rows[i]->truncate(0, rows[i]->size());
        depth = 0;
        while (depth < row->depth && depth < 16) {
            rows[i]->append("  ");
            depth = depth + 1;
        }
        if (row->kind == ENTRY_DIR)
            rows[i]->append("d ");
        else if (row->kind == ENTRY_LINK)
            rows[i]->append("l ");
        else if (row->kind == ENTRY_NOTE)
            rows[i]->append("n ");
        else
            rows[i]->append("f ");
        rows[i]->append(row->label);
        cells[0] = rows[i]->c_str();
        projectList->append_row(cells, 1);
        fileList->append_row(cells, 1);
        i = i + 1;
    }
}

void Ui::highlight(long index) {
    Highlighter *scan;
    Document *doc;
    const char *text;
    long i;
    long line;
    long col;
    long line2;
    long col2;
    long n;
    TextIter *start;
    TextIter *end;
    const char *name;
    Span *span;

    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    text = pages[index].buffer->get_text();
    n = text_length(text);
    if (n > 200000)
        return;
    ui_byte_pos(text, n, &line2, &col2);
    start = new TextIter(0, 0);
    end = new TextIter(line2, col2);
    if (pages[index].tags == 0) {
        pages[index].buffer->create_tag("keyword", "#2040c0");
        pages[index].buffer->create_tag("string", "#208020");
        pages[index].buffer->create_tag("comment", "#808080");
        pages[index].buffer->create_tag("number", "#804000");
        pages[index].buffer->create_tag("diag", "#c00000");
        pages[index].tags = 1;
    }
    pages[index].buffer->remove_tag("keyword", start, end);
    pages[index].buffer->remove_tag("string", start, end);
    pages[index].buffer->remove_tag("comment", start, end);
    pages[index].buffer->remove_tag("number", start, end);
    pages[index].buffer->remove_tag("diag", start, end);
    scan = new Highlighter();
    scan->scan(text, doc->language());
    i = 0;
    while (i < scan->count()) {
        span = scan->at(i);
        ui_byte_pos(text, span->start, &line, &col);
        ui_byte_pos(text, span->end, &line2, &col2);
        start = new TextIter(line, col);
        end = new TextIter(line2, col2);
        name = "keyword";
        if (span->kind == SPAN_STRING)
            name = "string";
        if (span->kind == SPAN_COMMENT)
            name = "comment";
        if (span->kind == SPAN_NUMBER)
            name = "number";
        pages[index].buffer->apply_tag(name, start, end);
        i = i + 1;
    }
    i = 0;
    while (i < state->lsp()->diag_count()) {
        line = state->lsp()->diag_line(i);
        start = new TextIter(line, 0);
        end = new TextIter(line, 200);
        pages[index].buffer->apply_tag("diag", start, end);
        i = i + 1;
    }
    if (state->lsp()->diag_count() > 0)
        pages[index].view->set_tooltip(
                state->lsp()->diag_message(0));
}

void Ui::paint_status(void) {
    String *line;
    char number[32];

    line = new String();
    line->append(state->status());
    if (state->hit_count() > 0) {
        line->append("  hits ");
        snprintf(number, 32, "%ld", state->hit_count());
        line->append(number);
    }
    status->set_text(line->c_str());
}

void Ui::refresh(void) {
    if (state->view_flag("editor.show_project_manager") == true)
        sideBox->set_visible(true);
    else
        sideBox->set_visible(false);
    if (pageCount != state->count())
        rebuild();
    else
        push_active();
    fill_menus();
    fill_lists();
    fill_messages();
    if (state->take_message_jump() == 1
            && messageBook != nullptr)
        messageBook->set_current_page(
                (long)state->message_page());
    paint_status();
}

void Ui::show_main(void) {
    refresh();
    mainWindow->present();
}

void Ui::show_choice(const char *title, int mode) {
    choiceMode = mode;
    choiceDialog->set_title(title);
    choiceDialog->present();
}

void Ui::show_goto(void) {
    gotoDialog->present();
}

void Ui::show_folder(int mode) {
    folderMode = mode;
    if (mode == 1)
        folderDialog->set_title("New Project");
    else if (mode == 2)
        folderDialog->set_title("Open Project");
    else if (mode == 3)
        folderDialog->set_title("Save Project As");
    else
        folderDialog->set_title("Open Folder");
    folderDialog->present();
}

void Ui::show_exclude(void) {
    String *text;

    text = state->project()->exclude_text();
    excludeEntry->set_text(text->c_str());
    excludeDialog->present();
}

void Ui::show_find(void) {
    findEntry->set_text(state->query());
    findWindow->present();
}

void Ui::show_about(void) {
    aboutWindow->present();
}

void Ui::show_prefs(void) {
    fontSize->set_value(state->settings()->get_number(
            "editor.font_size"));
    tabWidth->set_value(state->settings()->get_number(
            "editor.tab_width"));
    spacesCheck->set_active(state->settings()->get_flag(
            "editor.insert_spaces"));
    bracketsCheck->set_active(state->settings()->get_flag(
            "editor.auto_complete_brackets"));
    indentCheck->set_active(state->settings()->get_flag(
            "editor.auto_indent"));
    lspEntry->set_text(state->settings()->get_string(
            "editor.lsp_command"));
    prefWindow->present();
}

void Ui::handle(int code) {
    if (code == IDE_NEEDS_CHOICE) {
        if (state->pending() == PEND_WORKSPACE)
            show_choice("Workspace was not saved", 0);
        else
            show_choice("Save changes?", 0);
        return;
    }
    if (code == IDE_NEEDS_PATH || code == IDE_CHOOSE_SAVE) {
        files->set_title("Save");
        files->save(ui_saved, nullptr);
        return;
    }
    if (code == IDE_CHOOSE_OPEN) {
        files->set_title("Open");
        files->open(ui_opened, nullptr);
        return;
    }
    if (code == IDE_CHOOSE_FOLDER) {
        show_folder(0);
        return;
    }
    if (code == IDE_CHOOSE_NEW_PROJECT) {
        show_folder(1);
        return;
    }
    if (code == IDE_CHOOSE_OPEN_PROJECT) {
        show_folder(2);
        return;
    }
    if (code == IDE_CHOOSE_SAVE_PROJECT) {
        show_folder(3);
        return;
    }
    if (code == 2) {
        pendingPath = new String();
        pendingPath->append(folderEntry->text());
        show_choice("Replace project metadata?", 2);
        return;
    }
    if (state->show_goto() == 1)
        show_goto();
    if (state->show_configure() == 1)
        show_exclude();
    if (state->show_preferences() == 1)
        show_prefs();
    if (state->show_about() == 1)
        show_about();
    if (state->show_find() == 1)
        show_find();
    refresh();
}

void Ui::fill_messages(void) {
    char number[32];
    long i;
    long n;
    Document *doc;
    const char *path;

    if (searchList == nullptr || diagList == nullptr)
        return;
    if (buildList == nullptr || buildBuffer == nullptr)
        return;
    searchList->clear_rows();
    n = state->hit_count();
    if (n > IDE_ROWS)
        n = IDE_ROWS;
    i = 0;
    while (i < n) {
        snprintf(number, 32, "%ld", state->hit_line(i));
        ui_row3(
                searchList,
                state->hit_path(i),
                number,
                state->hit_text(i));
        i = i + 1;
    }
    diagList->clear_rows();
    doc = state->active();
    path = "";
    if (doc != nullptr && doc->untitled() == 0)
        path = doc->path();
    n = state->lsp()->diag_count();
    if (n > IDE_ROWS)
        n = IDE_ROWS;
    i = 0;
    while (i < n) {
        snprintf(
                number,
                32,
                "%ld",
                state->lsp()->diag_line(i) + 1);
        ui_row3(
                diagList,
                path,
                number,
                state->lsp()->diag_message(i));
        i = i + 1;
    }
    buildList->clear_rows();
    n = state->build_count();
    if (n > IDE_ROWS)
        n = IDE_ROWS;
    i = 0;
    while (i < n) {
        snprintf(number, 32, "%ld", state->build_line(i));
        ui_row3(
                buildList,
                state->build_path(i),
                number,
                state->build_text(i));
        i = i + 1;
    }
    if (text_same(
                buildBuffer->get_text(),
                state->build_output()) == 0)
        buildBuffer->set_text(state->build_output());
}

void Ui::reveal(long line) {
    long index;
    TextIter *at;

    if (line < 1)
        line = 1;
    index = state->index();
    if (index < 0 || index >= pageCount)
        return;
    if (pages[index].buffer == nullptr)
        return;
    at = new TextIter(line - 1, 0);
    pages[index].buffer->place_cursor(at);
    pages[index].view->scroll_to(line - 1, 0);
}

void Ui::open_at(const char *path, long line) {
    int code;

    if (line < 1)
        line = 1;
    if (path != nullptr && path[0] != 0) {
        code = state->open_file(path);
        if (code != IDE_OK) {
            handle(code);
            return;
        }
    }
    if (state->active() == nullptr)
        return;
    state->active()->buffer()->move_to(line, 1);
    refresh();
    reveal(line);
}

void Ui::open_path(const char *path) {
    if (path == nullptr || path[0] == 0)
        return;
    handle(state->open_file(path));
}

void Ui::save_path(const char *path) {
    int code;

    if (path == nullptr || path[0] == 0)
        return;
    pendingPath = new String();
    pendingPath->append(path);
    code = state->provide_path(path);
    if (code == IDE_FAILED
            && text_same(state->error(), "overwrite") == 1) {
        show_choice("Overwrite the file?", 1);
        return;
    }
    handle(code);
}

void Ui::use_folder(const char *path) {
    int code;

    if (path == nullptr || path[0] == 0)
        return;
    pendingPath = new String();
    pendingPath->append(path);
    if (folderMode == 1)
        code = state->project_new(path, 0);
    else if (folderMode == 2)
        code = state->project_open(path);
    else if (folderMode == 3)
        code = state->project_save_as(path, 0);
    else
        code = state->open_folder(path);
    handle(code);
}

void Ui::choice(int response) {
    if (choiceMode == 1) {
        if (response == IDE_SAVE) {
            state->allow_overwrite(1);
            handle(state->provide_path(pendingPath->c_str()));
        }
        return;
    }
    if (choiceMode == 2) {
        if (response == IDE_SAVE)
            handle(state->project_new(pendingPath->c_str(), 1));
        return;
    }
    handle(state->answer(response));
    if (state->quit_ready() == 1) {
        uiLive = 0;
        mainWindow->close();
    }
}

void Ui::goto_ok(void) {
    state->goto_line(gotoEntry->text());
    refresh();
}

void Ui::toggled_hidden(bool value) {
    state->explorer()->set_hidden(value);
    state->explorer()->refresh();
    refresh();
}

void Ui::changed(long index) {
    Document *doc;
    const char *text;
    int external;

    if (applying == 1)
        return;
    if (index < 0 || index >= pageCount)
        return;
    doc = state->at(index);
    if (doc == nullptr || pages[index].buffer == nullptr)
        return;
    text = pages[index].buffer->get_text();
    external = doc->buffer()->note_external(text);
    if (external == 1) {
        applying = 1;
        pages[index].buffer->set_text(doc->buffer()->text());
        applying = 0;
    }
    if (state->lsp()->running() == 1 && doc->untitled() == 0)
        state->lsp()->did_change(
                doc->path(),
                doc->buffer()->text());
    highlight(index);
    paint_status();
}

void Ui::moved(long index, long line, long offset) {
    Document *doc;

    if (index < 0 || index >= state->count())
        return;
    doc = state->at(index);
    if (doc == nullptr)
        return;
    doc->buffer()->move_to(line + 1, offset + 1);
    paint_status();
}

void Ui::switched(long index) {
    state->set_index(index);
    paint_status();
}

void Ui::tick(void) {
    state->poll_disk();
    state->lsp()->drain();
    state->snapshot_recovery();
    if (state->index() >= 0 && state->index() < pageCount)
        highlight(state->index());
    fill_messages();
    paint_status();
}

void Ui::find_clicked(void) {
    state->set_query(findEntry->text());
    state->set_replacement(replaceEntry->text());
    state->begin_find();
    refresh();
}

void Ui::replace_clicked(void) {
    state->set_query(findEntry->text());
    state->set_replacement(replaceEntry->text());
    state->replace_one();
    refresh();
}

void Ui::replace_all_clicked(void) {
    state->set_query(findEntry->text());
    state->set_replacement(replaceEntry->text());
    state->replace_every();
    refresh();
}

void Ui::apply_prefs(void) {
    state->settings()->set_number(
            "editor.font_size",
            (long)fontSize->value());
    state->settings()->set_number(
            "editor.tab_width",
            (long)tabWidth->value());
    state->settings()->set_flag(
            "editor.insert_spaces",
            spacesCheck->active());
    state->settings()->set_flag(
            "editor.auto_complete_brackets",
            bracketsCheck->active());
    state->settings()->set_flag(
            "editor.auto_indent",
            indentCheck->active());
    state->settings()->set_string(
            "editor.lsp_command",
            lspEntry->text());
    state->save_settings();
    state->apply_editor_prefs();
    refresh();
}

void Ui::configure_ok(void) {
    handle(state->project_configure(excludeEntry->text()));
}

void Ui::on_menu(const char *row) {
    char id[64];
    const char *rest;
    long i;

    if (row == nullptr)
        return;
    i = 0;
    while (row[i] != 0 && row[i] != '\t' && i < 63) {
        id[i] = row[i];
        i = i + 1;
    }
    id[i] = 0;
    rest = "";
    if (row[i] == '\t')
        rest = row + i + 1;
    if (text_same(id, "recent") == 1) {
        open_path(rest);
        return;
    }
    if (text_same(id, "find-project") == 1
            && findEntry != nullptr
            && findEntry->text()[0] != 0)
        state->set_query(findEntry->text());
    handle(state->run(id));
    if (state->quit_ready() == 1) {
        uiLive = 0;
        mainWindow->close();
    }
}

int Ui::start(void) {
    build();
    app->on_activate(ui_activate, nullptr);
    return app->run();
}
