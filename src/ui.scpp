#include "ui.shpp"
#include <stdlib>



Ui *ideUi;
Application *uiApp;
int uiLive;
int uiTicker;

void *ui_ticker(void *arg);

void ui_byte_pos(
        const char *text,
        long byte,
        long *line,
        long *col) {
    long i;

    *line = 0;
    *col = 0;
    if (text == nullptr)
        return;
    i = 0;
    while (text[i] != 0 && i < byte) {
        if (text[i] == '\n') {
            *line = *line + 1;
            *col = 0;
        }
        else
            *col = *col + 1;
        i = i + 1;
    }
}

void ui_activate(void *data) {
    pthread_t thread;

    (void)data;
    uiLive = 1;
    if (uiTicker == 0) {
        uiTicker = 1;
        pthread_create(&thread, nullptr, ui_ticker, nullptr);
    }
    ideUi->show_main();
}

void ui_menu(void *data, const char *label) {
    (void)data;
    ideUi->on_menu(label);
}

void ui_opened(void *data, const char *path) {
    (void)data;
    ideUi->open_path(path);
}

void ui_saved(void *data, const char *path) {
    (void)data;
    ideUi->save_path(path);
}

void ui_choice_response(void *data, int response) {
    (void)data;
    ideUi->choice(response);
}

void ui_goto_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->goto_ok();
}

void ui_folder_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->use_folder(ideUi->folderEntry->text());
}

void ui_exclude_response(void *data, int response) {
    (void)data;
    if (response == 1)
        ideUi->configure_ok();
}

bool ui_close(void *data) {
    int code;

    (void)data;
    code = ideUi->editor()->quit();
    if (ideUi->editor()->quit_ready() == 1) {
        uiLive = 0;
        return false;
    }
    ideUi->handle(code);
    return true;
}

void ui_hidden(void *data, bool value) {
    (void)data;
    ideUi->toggled_hidden(value);
}

void ui_hide_side(void *data) {
    (void)data;
    ideUi->editor()->set_view_flag(
            "editor.show_project_manager",
            false);
    ideUi->refresh();
}

void ui_refresh_tree(void *data) {
    (void)data;
    ideUi->editor()->explorer()->refresh();
    ideUi->refresh();
}

void ui_changed(void *data) {
    PageRef *ref;

    ref = (PageRef *)data;
    ideUi->changed(ref->index);
}

void ui_moved(void *data, long line, long offset) {
    PageRef *ref;

    ref = (PageRef *)data;
    ideUi->moved(ref->index, line, offset);
}

void ui_switched(void *data, long index) {
    (void)data;
    ideUi->switched(index);
}

void ui_search_row(void *data, long index) {
    (void)data;
    ideUi->open_at(
            ideUi->editor()->hit_path(index),
            ideUi->editor()->hit_line(index));
}

void ui_diag_row(void *data, long index) {
    Document *doc;
    const char *path;
    long line;

    (void)data;
    doc = ideUi->editor()->active();
    path = "";
    if (doc != nullptr && doc->untitled() == 0)
        path = doc->path();
    line = ideUi->editor()->lsp()->diag_line(index) + 1;
    ideUi->open_at(path, line);
}

void ui_build_row(void *data, long index) {
    (void)data;
    ideUi->open_at(
            ideUi->editor()->build_path(index),
            ideUi->editor()->build_line(index));
}

void ui_project_row(void *data, long index) {
    ExplorerEntry *row;

    (void)data;
    if (index < 0 || index >= ideUi->editor()->explorer()->count())
        return;
    row = ideUi->editor()->explorer()->at(index);
    if (row->kind == ENTRY_DIR)
        ideUi->editor()->explorer()->toggle(index);
    else if (row->kind == ENTRY_FILE || row->kind == ENTRY_LINK)
        ideUi->open_path(row->full->c_str());
    else
        ideUi->refresh();
}

void ui_tick(void *data) {
    (void)data;
    if (ideUi != nullptr)
        ideUi->tick();
}

void *ui_ticker(void *arg) {
    struct timespec delay;

    (void)arg;
    delay.tv_sec = 3;
    delay.tv_nsec = 0;
    while (uiLive == 1) {
        nanosleep(&delay, nullptr);
        if (uiLive == 1 && uiApp != nullptr)
            uiApp->post(ui_tick, nullptr);
    }
    return nullptr;
}

void ui_find(void *data) {
    (void)data;
    ideUi->find_clicked();
}

void ui_replace(void *data) {
    (void)data;
    ideUi->replace_clicked();
}

void ui_replace_all(void *data) {
    (void)data;
    ideUi->replace_all_clicked();
}

void ui_apply_prefs(void *data) {
    (void)data;
    ideUi->apply_prefs();
}

Ui::Ui(Session *session) {
    long i;

    state = session;
    applying = 0;
    pageCount = 0;
    folderMode = 0;
    choiceMode = 0;
    pendingPath = new String();
    fileMenu = nullptr;
    editMenu = nullptr;
    searchMenu = nullptr;
    viewMenu = nullptr;
    projectMenu = nullptr;
    buildMenu = nullptr;
    helpMenu = nullptr;
    messageBook = nullptr;
    searchList = nullptr;
    diagList = nullptr;
    buildList = nullptr;
    buildBuffer = nullptr;
    buildView = nullptr;
    vsplit = nullptr;
    i = 0;
    while (i < IDE_PAGES) {
        pages[i].buffer = nullptr;
        pages[i].view = nullptr;
        pages[i].scroll = nullptr;
        pages[i].tags = 0;
        refs[i].index = i;
        i = i + 1;
    }
    i = 0;
    while (i < 20) {
        recentText[i] = new String();
        i = i + 1;
    }
    i = 0;
    while (i < IDE_ROWS) {
        rows[i] = nullptr;
        i = i + 1;
    }
    ideUi = this;
    uiLive = 0;
    uiTicker = 0;
}

Session *Ui::editor(void) {
    return state;
}

/* malloc, not new. The collector moves new buffers,
 * and the menu model reads the label after later
 * allocations. A malloc copy stays put.
 */
char *ui_keep(const char *text) {
    long n;
    long i;
    char *copy;

    if (text == nullptr)
        text = "";
    n = 0;
    while (text[n] != 0)
        n = n + 1;
    copy = (char *)malloc((unsigned long)(n + 1));
    if (copy == nullptr)
        return nullptr;
    i = 0;
    while (i <= n) {
        copy[i] = text[i];
        i = i + 1;
    }
    return copy;
}

void ui_free(char *text) {
    if (text != nullptr)
        free((void *)text);
}

char *ui_menu_row(
        const char *id,
        const char *label,
        const char *binding) {
    long idN;
    long labelN;
    long bindN;
    long n;
    long i;
    long at;
    char *row;

    if (id == nullptr)
        id = "";
    if (label == nullptr)
        label = "";
    if (binding == nullptr)
        binding = "";
    idN = 0;
    while (id[idN] != 0)
        idN = idN + 1;
    labelN = 0;
    while (label[labelN] != 0)
        labelN = labelN + 1;
    bindN = 0;
    while (binding[bindN] != 0)
        bindN = bindN + 1;
    n = idN + 1 + labelN;
    if (bindN > 0)
        n = n + 2 + bindN;
    row = (char *)malloc((unsigned long)(n + 1));
    if (row == nullptr)
        return nullptr;
    i = 0;
    while (i < idN) {
        row[i] = id[i];
        i = i + 1;
    }
    at = idN;
    row[at] = '\t';
    at = at + 1;
    i = 0;
    while (i < labelN) {
        row[at + i] = label[i];
        i = i + 1;
    }
    at = at + labelN;
    if (bindN > 0) {
        row[at] = ' ';
        row[at + 1] = ' ';
        at = at + 2;
        i = 0;
        while (i < bindN) {
            row[at + i] = binding[i];
            i = i + 1;
        }
        at = at + bindN;
    }
    row[at] = 0;
    return row;
}

void ui_row3(
        ColumnView *view,
        const char *a,
        const char *b,
        const char *c) {
    char *ca;
    char *cb;
    char *cc;
    const char *cells[3];

    ca = ui_keep(a);
    cb = ui_keep(b);
    cc = ui_keep(c);
    cells[0] = "";
    cells[1] = "";
    cells[2] = "";
    if (ca != nullptr)
        cells[0] = ca;
    if (cb != nullptr)
        cells[1] = cb;
    if (cc != nullptr)
        cells[2] = cc;
    view->append_row(cells, 3);
    ui_free(ca);
    ui_free(cb);
    ui_free(cc);
}

