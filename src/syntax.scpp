#include "syntax.shpp"

SpanVec::SpanVec() : Array((long)sizeof(Span *)) {
}

void SpanVec::add(Span * value) {
    Span * *place;
    reserve(count + 1);
    place = (Span * *)(bytes + count * stride);
    *place = value;
    count = count + 1;
}

Span * SpanVec::at(long index) {
    Span * *place;
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        throw *new Exception("index");
    place = (Span * *)address(index);
    return *place;
}

long SpanVec::find(Span * value) {
    Span * *place;
    long i;
    i = 0;
    while (i < count) {
        place = (Span * *)(bytes + i * stride);
        if (*place == value)
            return i;
        i = i + 1;
    }
    return -1;
}

void SpanVec::replace(long index, Span * value) {
    Span * *place;
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        throw *new Exception("index");
    place = (Span * *)address(index);
    *place = value;
}

void SpanVec::insert(long index, Span * value) {
    Span * *place;
    long i;
    if (index < 0)
        index = count + index;
    if (index < 0)
        index = 0;
    if (index > count)
        index = count;
    reserve(count + 1);
    i = count;
    while (i > index) {
        place = (Span * *)(bytes + i * stride);
        *place = *(Span * *)(bytes + (i - 1) * stride);
        i = i - 1;
    }
    place = (Span * *)(bytes + index * stride);
    *place = value;
    count = count + 1;
}

void SpanVec::remove(long index) {
    Span * *place;
    long i;
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        throw *new Exception("index");
    i = index;
    while (i + 1 < count) {
        place = (Span * *)(bytes + i * stride);
        *place = *(Span * *)(bytes + (i + 1) * stride);
        i = i + 1;
    }
    count = count - 1;
}

Span * SpanVec::next(long *cursor) {
    long index;
    if (cursor == nullptr)
        throw *new Exception("index");
    index = *cursor;
    if (index < 0)
        index = count + index;
    if (index < 0 || index >= count)
        throw *new Exception("index");
    *cursor = index + 1;
    return at(index);
}


Highlighter::Highlighter() {
    spans = new SpanVec();
}

void Highlighter::add_span(long start, long end, int kind) {
    Span *span;

    if (end <= start)
        return;
    span = new Span();
    span->start = start;
    span->end = end;
    span->kind = kind;
    spans->add(span);
}

long Highlighter::count(void) {
    return spans->size();
}

Span *Highlighter::at(long index) {
    return spans->at(index);
}

int Highlighter::is_word(
        const char *raw,
        long n,
        long at,
        const char *word) {
    long i;

    i = 0;
    while (word[i] != 0) {
        if (at + i >= n || raw[at + i] != word[i])
            return 0;
        i = i + 1;
    }
    if (at > 0 && is_ident(byte_at(raw, at - 1)) == 1)
        return 0;
    if (at + i < n && is_ident(byte_at(raw, at + i)) == 1)
        return 0;
    return 1;
}

int Highlighter::keyword(const char *language, const char *word) {
    const char *code[48];
    const char *py[16];
    long i;
    long n;

    code[0] = "class";
    code[1] = "public";
    code[2] = "private";
    code[3] = "if";
    code[4] = "else";
    code[5] = "for";
    code[6] = "while";
    code[7] = "return";
    code[8] = "new";
    code[9] = "delete";
    code[10] = "int";
    code[11] = "long";
    code[12] = "char";
    code[13] = "bool";
    code[14] = "void";
    code[15] = "const";
    code[16] = "struct";
    code[17] = "enum";
    code[18] = "true";
    code[19] = "false";
    code[20] = "nullptr";
    code[21] = "namespace";
    code[22] = "using";
    code[23] = "virtual";
    code[24] = "throw";
    code[25] = "catch";
    code[26] = "try";
    n = 27;
    py[0] = "class";
    py[1] = "def";
    py[2] = "if";
    py[3] = "else";
    py[4] = "for";
    py[5] = "while";
    py[6] = "return";
    py[7] = "import";
    py[8] = "True";
    py[9] = "False";
    py[10] = "None";
    if (text_same(language, "python") == 1) {
        i = 0;
        while (i < 11) {
            if (text_same(word, py[i]) == 1)
                return 1;
            i = i + 1;
        }
        return 0;
    }
    if (text_same(language, "plain") == 1)
        return 0;
    if (text_same(language, "markdown") == 1)
        return 0;
    if (text_same(language, "toml") == 1)
        return 0;
    i = 0;
    while (i < n) {
        if (text_same(word, code[i]) == 1)
            return 1;
        i = i + 1;
    }
    return 0;
}

void Highlighter::scan(const char *text, const char *language) {
    long i;
    long n;
    long start;
    int ch;
    int hash;
    String *word;

    spans = new SpanVec();
    if (text == nullptr || language == nullptr)
        return;
    if (text_same(language, "plain") == 1)
        return;
    if (text_same(language, "markdown") == 1)
        return;
    hash = 0;
    if (text_same(language, "python") == 1
            || text_same(language, "shell") == 1
            || text_same(language, "toml") == 1)
        hash = 1;
    n = text_length(text);
    i = 0;
    while (i < n) {
        ch = byte_at(text, i);
        if (ch == '/' && i + 1 < n && text[i + 1] == '/') {
            start = i;
            while (i < n && text[i] != '\n')
                i = i + 1;
            add_span(start, i, SPAN_COMMENT);
            continue;
        }
        if (hash == 1 && ch == '#') {
            start = i;
            while (i < n && text[i] != '\n')
                i = i + 1;
            add_span(start, i, SPAN_COMMENT);
            continue;
        }
        if (ch == '/' && i + 1 < n && text[i + 1] == '*') {
            start = i;
            i = i + 2;
            while (i + 1 < n
                    && (text[i] != '*' || text[i + 1] != '/'))
                i = i + 1;
            if (i + 1 < n)
                i = i + 2;
            else
                i = n;
            add_span(start, i, SPAN_COMMENT);
            continue;
        }
        if (ch == '"' || ch == '\'') {
            int quote;

            quote = ch;
            start = i;
            i = i + 1;
            while (i < n) {
                if (text[i] == '\\' && i + 1 < n) {
                    i = i + 2;
                    continue;
                }
                if (byte_at(text, i) == quote) {
                    i = i + 1;
                    break;
                }
                if (text[i] == '\n')
                    break;
                i = i + 1;
            }
            add_span(start, i, SPAN_STRING);
            continue;
        }
        if (ch >= '0' && ch <= '9') {
            if (i == 0 || is_ident(byte_at(text, i - 1)) == 0) {
                start = i;
                while (i < n && text[i] >= '0' && text[i] <= '9')
                    i = i + 1;
                add_span(start, i, SPAN_NUMBER);
                continue;
            }
        }
        if (is_ident(ch) == 1 && (ch < '0' || ch > '9')) {
            start = i;
            word = new String();
            while (i < n && is_ident(byte_at(text, i)) == 1) {
                word->add(text[i]);
                i = i + 1;
            }
            if (keyword(language, word->c_str()) == 1)
                add_span(start, i, SPAN_KEYWORD);
            continue;
        }
        i = i + 1;
    }
}
