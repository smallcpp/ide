#include "settings.shpp"



const char *ide_command(long index) {
    if (index == 0)
        return "new";
    if (index == 1)
        return "open";
    if (index == 2)
        return "save";
    if (index == 3)
        return "save-as";
    if (index == 4)
        return "save-all";
    if (index == 5)
        return "close";
    if (index == 6)
        return "close-all";
    if (index == 7)
        return "quit";
    if (index == 8)
        return "find";
    if (index == 9)
        return "replace";
    if (index == 10)
        return "find-project";
    if (index == 11)
        return "goto-line";
    if (index == 12)
        return "undo";
    if (index == 13)
        return "redo";
    if (index == 14)
        return "cut";
    if (index == 15)
        return "copy";
    if (index == 16)
        return "paste";
    if (index == 17)
        return "select-all";
    if (index == 18)
        return "strip-trailing-spaces";
    if (index == 19)
        return "comment";
    if (index == 20)
        return "block-comment";
    if (index == 21)
        return "indent";
    if (index == 22)
        return "outdent";
    if (index == 23)
        return "preferences";
    if (index == 24)
        return "reload";
    if (index == 25)
        return "open-folder";
    if (index == 26)
        return "project-new";
    if (index == 27)
        return "project-open";
    if (index == 28)
        return "project-close";
    if (index == 29)
        return "project-save";
    if (index == 30)
        return "project-save-as";
    if (index == 31)
        return "project-delete";
    if (index == 32)
        return "project-configure";
    if (index == 33)
        return "about";
    if (index == 34)
        return "show-line-numbers";
    if (index == 35)
        return "show-whitespace";
    if (index == 36)
        return "show-line-ends";
    if (index == 37)
        return "show-project-manager";
    if (index == 38)
        return "show-indent-markers";
    if (index == 39)
        return "insert-column";
    if (index == 40)
        return "delete-column";
    if (index == 41)
        return "plugin-time";
    if (index == 42)
        return "plugin-debug";
    if (index == 43)
        return "build-compile";
    if (index == 44)
        return "build-build";
    if (index == 45)
        return "build-run";
    if (index == 46)
        return "focus-search";
    if (index == 47)
        return "focus-messages";
    return "";
}

const char *ide_default_binding(const char *command) {
    if (text_same(command, "new") == 1)
        return "<Control>n";
    if (text_same(command, "open") == 1)
        return "<Control>o";
    if (text_same(command, "save") == 1)
        return "<Control>s";
    if (text_same(command, "save-as") == 1)
        return "<Control><Shift>s";
    if (text_same(command, "save-all") == 1)
        return "<Control><Alt>s";
    if (text_same(command, "close") == 1)
        return "<Control>w";
    if (text_same(command, "close-all") == 1)
        return "<Control><Shift>w";
    if (text_same(command, "quit") == 1)
        return "<Control>q";
    if (text_same(command, "find") == 1)
        return "<Control>f";
    if (text_same(command, "replace") == 1)
        return "<Control>h";
    if (text_same(command, "find-project") == 1)
        return "<Control><Shift>f";
    if (text_same(command, "goto-line") == 1)
        return "<Control>g";
    if (text_same(command, "undo") == 1)
        return "<Control>z";
    if (text_same(command, "redo") == 1)
        return "<Control><Shift>z";
    if (text_same(command, "cut") == 1)
        return "<Control>x";
    if (text_same(command, "copy") == 1)
        return "<Control>c";
    if (text_same(command, "paste") == 1)
        return "<Control>v";
    if (text_same(command, "select-all") == 1)
        return "<Control>a";
    if (text_same(command, "preferences") == 1)
        return "<Control>comma";
    if (text_same(command, "comment") == 1)
        return "<Control>slash";
    if (text_same(command, "indent") == 1)
        return "Tab";
    if (text_same(command, "outdent") == 1)
        return "<Shift>Tab";
    return "";
}

Settings::Settings() {
    file = new TomlDoc();
    snapshot = new String();
    sawFile = 0;
    bad = 0;
    allowSave = 1;
    errorText = new String();
    reset_defaults();
}

TomlDoc *Settings::doc(void) {
    return file;
}

void Settings::note(const char *msg) {
    bad = 1;
    allowSave = 0;
    if (errorText->size() > 0)
        errorText->append("; ");
    if (msg != nullptr)
        errorText->append(msg);
}

int Settings::failed(void) {
    return bad;
}

int Settings::autosave(void) {
    return allowSave;
}

const char *Settings::error(void) {
    return errorText->c_str();
}

int Settings::command_known(const char *command) {
    long i;

    i = 0;
    while (i < IDE_COMMANDS) {
        if (text_same(ide_command(i), command) == 1)
            return 1;
        i = i + 1;
    }
    return 0;
}

const char *Settings::command_at(long index) {
    return ide_command(index);
}

long Settings::command_count(void) {
    return IDE_COMMANDS;
}

const char *Settings::default_binding(const char *command) {
    return ide_default_binding(command);
}

