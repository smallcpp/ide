#ifndef IDE_BUFFER
#define IDE_BUFFER

/* Editable text, undo, search, and the line commands.
 * Offsets are bytes. Lines and columns that cross the
 * GTK view are character positions, zero-based there
 * and one-based in move_to.
 */
#include "util.scpp"

class EditMark {
public:
    String *text;
    long cursor;
    long anchor;
    bool dirty;
    bool scopeOn;
    long scopeStart;
    long scopeEnd;
};

VECTOR(MarkVec, EditMark *)

class EditBuffer {
public:
    EditBuffer();
    void set_text(const char *value);
    const char *text(void);
    long size(void);
    bool dirty(void);
    void mark_clean(void);
    void mark_dirty(void);
    long cursor_offset(void);
    long anchor_offset(void);
    void set_cursor_offset(long offset);
    void select_all(void);
    bool has_selection(void);
    long sel_lo(void);
    long sel_hi(void);
    String *selected(void);
    long line_count(void);
    long cursor_line(void);
    long cursor_column(void);
    void line_column_at(
            long offset,
            long *line,
            long *column);
    long byte_at_line(long line, long column);
    void move_to(long line, long column);
    void select_span(
            long line,
            long column,
            long line2,
            long column2);
    void insert_text(const char *value);
    void backspace(void);
    void delete_forward(void);
    bool can_undo(void);
    bool can_redo(void);
    void undo(void);
    void redo(void);
    void strip_trailing(void);
    void toggle_line_comment(const char *leader);
    void toggle_block_comment(void);
    void indent_lines(long width, bool spaces);
    void outdent_lines(long width, bool spaces);
    void insert_column(const char *value);
    void delete_column(void);
    int find_next(
            const char *query,
            bool matchCase,
            bool whole,
            bool inSel);
    int replace_next(
            const char *query,
            const char *repl,
            bool matchCase,
            bool whole,
            bool inSel);
    int replace_all(
            const char *query,
            const char *repl,
            bool matchCase,
            bool whole,
            bool inSel);
    void capture_scope(void);
    void clear_scope(void);
    bool scope_active(void);
    void set_auto_brackets(bool value);
    void set_auto_indent(bool value);
    bool auto_brackets(void);
    bool auto_indent(void);
    int note_external(const char *value);
    bool selection_one_line(void);
private:
    String *body;
    long cursor;
    long anchor;
    bool dirtyFlag;
    bool scopeOn;
    long scopeStart;
    long scopeEnd;
    bool hasMatch;
    long matchStart;
    long matchEnd;
    bool brackets;
    bool indentOn;
    bool multi;
    MarkVec *undoStack;
    MarkVec *redoStack;
    void assign(const char *value);
    void clamp_point(void);
    void push_undo(void);
    void clear_marks(MarkVec *marks);
    void restore(EditMark *mark);
    void splice(long from, long to, const char *value);
    void shift_scope(long at, long delta);
    int match_at(
            long index,
            const char *query,
            bool matchCase,
            bool whole);
    long find_from(
            long from,
            long limit,
            const char *query,
            bool matchCase,
            bool whole);
    void replace_span(long from, long to, const char *repl);
    void finish_brackets(
            long prefix,
            long insLen,
            long delLen,
            const char *oldText,
            long oldFrom,
            long oldTo);
    void line_range(long *first, long *last);
    bool spans_lines(void);
    int leading_indent(long lineStart, long *indentEnd);
};

EditBuffer::EditBuffer() {
    body = new String();
    cursor = 0;
    anchor = 0;
    dirtyFlag = false;
    scopeOn = false;
    scopeStart = 0;
    scopeEnd = 0;
    hasMatch = false;
    matchStart = 0;
    matchEnd = 0;
    brackets = true;
    indentOn = true;
    multi = true;
    undoStack = new MarkVec();
    redoStack = new MarkVec();
}

void EditBuffer::assign(const char *value) {
    body = new String();
    if (value != nullptr)
        body->append(value);
    clamp_point();
}

void EditBuffer::clamp_point(void) {
    long n;

    n = body->size();
    if (cursor < 0)
        cursor = 0;
    if (anchor < 0)
        anchor = 0;
    if (cursor > n)
        cursor = n;
    if (anchor > n)
        anchor = n;
}

void EditBuffer::clear_marks(MarkVec *marks) {
    while (marks->size() > 0)
        marks->remove(0);
}

void EditBuffer::push_undo(void) {
    EditMark *mark;

    mark = new EditMark();
    mark->text = new String(body);
    mark->cursor = cursor;
    mark->anchor = anchor;
    mark->dirty = dirtyFlag;
    mark->scopeOn = scopeOn;
    mark->scopeStart = scopeStart;
    mark->scopeEnd = scopeEnd;
    undoStack->add(mark);
    while (undoStack->size() > 100)
        undoStack->remove(0);
    clear_marks(redoStack);
}

void EditBuffer::restore(EditMark *mark) {
    body = new String(mark->text);
    cursor = mark->cursor;
    anchor = mark->anchor;
    dirtyFlag = mark->dirty;
    scopeOn = mark->scopeOn;
    scopeStart = mark->scopeStart;
    scopeEnd = mark->scopeEnd;
    hasMatch = false;
    clamp_point();
}

void EditBuffer::set_text(const char *value) {
    assign(value);
    cursor = 0;
    anchor = 0;
    dirtyFlag = false;
    scopeOn = false;
    hasMatch = false;
    clear_marks(undoStack);
    clear_marks(redoStack);
}

const char *EditBuffer::text(void) {
    return body->c_str();
}

long EditBuffer::size(void) {
    return body->size();
}

bool EditBuffer::dirty(void) {
    return dirtyFlag;
}

void EditBuffer::mark_clean(void) {
    dirtyFlag = false;
}

void EditBuffer::mark_dirty(void) {
    dirtyFlag = true;
}

long EditBuffer::cursor_offset(void) {
    return cursor;
}

long EditBuffer::anchor_offset(void) {
    return anchor;
}

void EditBuffer::set_cursor_offset(long offset) {
    cursor = offset;
    anchor = offset;
    clamp_point();
}

void EditBuffer::select_all(void) {
    anchor = 0;
    cursor = body->size();
}

bool EditBuffer::has_selection(void) {
    return cursor != anchor;
}

long EditBuffer::sel_lo(void) {
    if (cursor < anchor)
        return cursor;
    return anchor;
}

long EditBuffer::sel_hi(void) {
    if (cursor > anchor)
        return cursor;
    return anchor;
}

String *EditBuffer::selected(void) {
    return slice_text(body->c_str(), sel_lo(), sel_hi());
}

void EditBuffer::line_column_at(
        long offset,
        long *line,
        long *column) {
    long i;
    long n;
    long row;
    long col;
    int value;
    int step;
    const char *raw;

    row = 0;
    col = 0;
    raw = body->c_str();
    n = body->size();
    if (offset < 0)
        offset = 0;
    if (offset > n)
        offset = n;
    i = 0;
    while (i < offset) {
        value = byte_at(raw, i);
        if (value == '\n') {
            row = row + 1;
            col = 0;
            i = i + 1;
            continue;
        }
        step = utf8_len(value);
        if (i + step > offset)
            break;
        col = col + 1;
        i = i + step;
    }
    if (line != nullptr)
        *line = row;
    if (column != nullptr)
        *column = col;
}

long EditBuffer::byte_at_line(long line, long column) {
    long i;
    long n;
    long row;
    long col;
    int value;
    int step;
    const char *raw;

    if (line < 0)
        line = 0;
    if (column < 0)
        column = 0;
    raw = body->c_str();
    n = body->size();
    i = 0;
    row = 0;
    while (i < n && row < line) {
        if (raw[i] == '\n')
            row = row + 1;
        i = i + 1;
    }
    col = 0;
    while (i < n && col < column && raw[i] != '\n') {
        value = byte_at(raw, i);
        step = utf8_len(value);
        if (i + step > n)
            break;
        i = i + step;
        col = col + 1;
    }
    return i;
}

long EditBuffer::line_count(void) {
    long i;
    long n;
    long rows;
    const char *raw;

    raw = body->c_str();
    n = body->size();
    rows = 1;
    i = 0;
    while (i < n) {
        if (raw[i] == '\n')
            rows = rows + 1;
        i = i + 1;
    }
    return rows;
}

long EditBuffer::cursor_line(void) {
    long line;
    long column;

    line_column_at(cursor, &line, &column);
    return line + 1;
}

long EditBuffer::cursor_column(void) {
    long line;
    long column;

    line_column_at(cursor, &line, &column);
    return column + 1;
}

void EditBuffer::move_to(long line, long column) {
    if (line < 1)
        line = 1;
    if (column < 1)
        column = 1;
    if (line > line_count())
        line = line_count();
    cursor = byte_at_line(line - 1, column - 1);
    anchor = cursor;
}

void EditBuffer::select_span(
        long line,
        long column,
        long line2,
        long column2) {
    if (line < 1)
        line = 1;
    if (column < 1)
        column = 1;
    if (line2 < 1)
        line2 = 1;
    if (column2 < 1)
        column2 = 1;
    anchor = byte_at_line(line - 1, column - 1);
    cursor = byte_at_line(line2 - 1, column2 - 1);
}

void EditBuffer::shift_scope(long at, long delta) {
    if (scopeOn == false)
        return;
    if (at <= scopeStart)
        scopeStart = scopeStart + delta;
    if (at <= scopeEnd)
        scopeEnd = scopeEnd + delta;
    if (scopeStart < 0)
        scopeStart = 0;
    if (scopeEnd > body->size())
        scopeEnd = body->size();
    if (scopeStart >= scopeEnd)
        scopeOn = false;
}

void EditBuffer::splice(
        long from,
        long to,
        const char *value) {
    String *next;
    long n;
    long added;
    const char *raw;

    n = body->size();
    if (from < 0)
        from = 0;
    if (to > n)
        to = n;
    if (to < from)
        to = from;
    added = text_length(value) - (to - from);
    next = new String();
    raw = body->c_str();
    append_range(next, raw, 0, from);
    if (value != nullptr)
        next->append(value);
    append_range(next, raw, to, n);
    body = next;
    if (cursor >= to)
        cursor = cursor + added;
    else if (cursor > from)
        cursor = from;
    if (anchor >= to)
        anchor = anchor + added;
    else if (anchor > from)
        anchor = from;
    shift_scope(from, added);
    hasMatch = false;
    dirtyFlag = true;
    clamp_point();
}

bool EditBuffer::spans_lines(void) {
    long line;
    long column;
    long line2;
    long column2;

    if (has_selection() == false)
        return false;
    line_column_at(sel_lo(), &line, &column);
    line_column_at(sel_hi(), &line2, &column2);
    if (line != line2)
        return true;
    return false;
}

void EditBuffer::finish_brackets(
        long prefix,
        long insLen,
        long delLen,
        const char *oldText,
        long oldFrom,
        long oldTo) {
    int ch;
    int close;
    char pair[2];
    char extra[2];
    const char *raw;
    String *wrapped;
    long indent;
    long start;
    long at;

    raw = body->c_str();
    if (insLen == 1 && delLen == 0 && brackets == true) {
        ch = byte_at(raw, prefix);
        if (prefix + 1 < body->size()
                && byte_at(raw, prefix + 1) == ch
                && (ch == ')' || ch == ']' || ch == '}'
                    || ch == '"' || ch == '\'')) {
            splice(prefix, prefix + 1, "");
            cursor = prefix + 1;
            anchor = cursor;
            return;
        }
        close = 0;
        if (ch == '(')
            close = ')';
        if (ch == '[')
            close = ']';
        if (ch == '{')
            close = '}';
        if (ch == '"')
            close = '"';
        if (ch == '\'')
            close = '\'';
        if (close != 0) {
            pair[0] = (char)close;
            pair[1] = 0;
            splice(prefix + 1, prefix + 1, pair);
            cursor = prefix + 1;
            anchor = cursor;
            return;
        }
    }
    if (insLen == 1 && delLen > 0 && brackets == true) {
        ch = byte_at(body->c_str(), prefix);
        close = 0;
        if (ch == '(')
            close = ')';
        if (ch == '[')
            close = ']';
        if (ch == '{')
            close = '}';
        if (ch == '"')
            close = '"';
        if (ch == '\'')
            close = '\'';
        if (close != 0 && oldText != nullptr) {
            wrapped = new String();
            extra[0] = (char)ch;
            extra[1] = 0;
            wrapped->append(extra);
            append_range(wrapped, oldText, oldFrom, oldTo);
            pair[0] = (char)close;
            pair[1] = 0;
            wrapped->append(pair);
            splice(prefix, prefix + 1, wrapped->c_str());
            cursor = prefix + wrapped->size();
            anchor = cursor;
            return;
        }
    }
    if (insLen == 0 && delLen == 1 && brackets == true) {
        if (oldText != nullptr && oldFrom < oldTo) {
            ch = byte_at(oldText, oldFrom);
            close = 0;
            if (ch == '(')
                close = ')';
            if (ch == '[')
                close = ']';
            if (ch == '{')
                close = '}';
            if (ch == '"')
                close = '"';
            if (ch == '\'')
                close = '\'';
            if (close != 0
                    && cursor < body->size()
                    && byte_at(body->c_str(), cursor) == close) {
                splice(cursor, cursor + 1, "");
                return;
            }
        }
    }
    if (insLen == 1
            && delLen == 0
            && indentOn == true
            && byte_at(body->c_str(), prefix) == '\n') {
        start = prefix;
        while (start > 0
                && byte_at(body->c_str(), start - 1) != '\n')
            start = start - 1;
        indent = start;
        while (indent < prefix) {
            ch = byte_at(body->c_str(), indent);
            if (ch != ' ' && ch != '\t')
                break;
            indent = indent + 1;
        }
        if (indent > start) {
            wrapped = slice_text(
                    body->c_str(),
                    start,
                    indent);
            at = prefix + 1;
            splice(at, at, wrapped->c_str());
            cursor = at + wrapped->size();
            anchor = cursor;
        }
    }
}

void EditBuffer::insert_text(const char *value) {
    long lo;
    long hi;
    long prefix;
    const char *oldRaw;
    String *oldCopy;

    if (value == nullptr)
        return;
    if (multi == true && spans_lines() == true) {
        insert_column(value);
        return;
    }
    push_undo();
    lo = sel_lo();
    hi = sel_hi();
    oldCopy = new String(body);
    oldRaw = oldCopy->c_str();
    prefix = lo;
    splice(lo, hi, value);
    cursor = prefix + text_length(value);
    anchor = cursor;
    finish_brackets(
            prefix,
            text_length(value),
            hi - lo,
            oldRaw,
            lo,
            hi);
}

void EditBuffer::backspace(void) {
    long lo;
    long hi;
    int step;
    int value;
    const char *oldRaw;
    String *oldCopy;
    long from;

    if (has_selection() == true) {
        push_undo();
        lo = sel_lo();
        hi = sel_hi();
        splice(lo, hi, "");
        cursor = lo;
        anchor = lo;
        return;
    }
    if (cursor == 0)
        return;
    value = byte_at(body->c_str(), cursor - 1);
    step = 1;
    if (cursor >= 2) {
        from = cursor - 1;
        while (from > 0
                && (byte_at(body->c_str(), from) & 192) == 128)
            from = from - 1;
        step = (int)(cursor - from);
        if (step > 4)
            step = 1;
    }
    (void)value;
    push_undo();
    oldCopy = new String(body);
    oldRaw = oldCopy->c_str();
    from = cursor - step;
    splice(from, cursor, "");
    cursor = from;
    anchor = from;
    finish_brackets(from, 0, step, oldRaw, from, from + step);
}

void EditBuffer::delete_forward(void) {
    long lo;
    long hi;
    int value;
    int step;

    if (has_selection() == true) {
        push_undo();
        lo = sel_lo();
        hi = sel_hi();
        splice(lo, hi, "");
        cursor = lo;
        anchor = lo;
        return;
    }
    if (cursor >= body->size())
        return;
    value = byte_at(body->c_str(), cursor);
    step = utf8_len(value);
    if (cursor + step > body->size())
        step = 1;
    push_undo();
    splice(cursor, cursor + step, "");
    anchor = cursor;
}

bool EditBuffer::can_undo(void) {
    return undoStack->size() > 0;
}

bool EditBuffer::can_redo(void) {
    return redoStack->size() > 0;
}

void EditBuffer::undo(void) {
    EditMark *mark;
    EditMark *now;
    long n;

    n = undoStack->size();
    if (n == 0)
        return;
    now = new EditMark();
    now->text = new String(body);
    now->cursor = cursor;
    now->anchor = anchor;
    now->dirty = dirtyFlag;
    now->scopeOn = scopeOn;
    now->scopeStart = scopeStart;
    now->scopeEnd = scopeEnd;
    redoStack->add(now);
    mark = undoStack->at(n - 1);
    undoStack->remove(n - 1);
    restore(mark);
}

void EditBuffer::redo(void) {
    EditMark *mark;
    EditMark *now;
    long n;

    n = redoStack->size();
    if (n == 0)
        return;
    now = new EditMark();
    now->text = new String(body);
    now->cursor = cursor;
    now->anchor = anchor;
    now->dirty = dirtyFlag;
    now->scopeOn = scopeOn;
    now->scopeStart = scopeStart;
    now->scopeEnd = scopeEnd;
    undoStack->add(now);
    mark = redoStack->at(n - 1);
    redoStack->remove(n - 1);
    restore(mark);
}

void EditBuffer::strip_trailing(void) {
    String *next;
    const char *raw;
    long i;
    long n;
    long start;
    long end;
    int value;

    raw = body->c_str();
    n = body->size();
    next = new String();
    i = 0;
    while (i < n) {
        start = i;
        while (i < n && raw[i] != '\n')
            i = i + 1;
        end = i;
        while (end > start) {
            value = byte_at(raw, end - 1);
            if (value != ' ' && value != '\t')
                break;
            end = end - 1;
        }
        append_range(next, raw, start, end);
        if (i < n && raw[i] == '\n') {
            next->add('\n');
            i = i + 1;
        }
    }
    if (text_same(next->c_str(), raw) == 1)
        return;
    push_undo();
    body = next;
    dirtyFlag = true;
    hasMatch = false;
    clamp_point();
}

void EditBuffer::line_range(long *first, long *last) {
    long line;
    long column;
    long line2;
    long column2;
    long lo;
    long hi;

    lo = cursor;
    hi = cursor;
    if (has_selection() == true) {
        lo = sel_lo();
        hi = sel_hi();
    }
    line_column_at(lo, &line, &column);
    line_column_at(hi, &line2, &column2);
    if (hi > lo && column2 == 0 && line2 > line)
        line2 = line2 - 1;
    if (first != nullptr)
        *first = line;
    if (last != nullptr)
        *last = line2;
}

void EditBuffer::toggle_line_comment(const char *leader) {
    long first;
    long last;
    long line;
    long start;
    long at;
    long n;
    int all;
    int value;
    const char *raw;
    String *next;
    long lead;
    long keep;

    if (leader == nullptr || leader[0] == 0)
        leader = "//";
    lead = text_length(leader);
    line_range(&first, &last);
    all = 1;
    line = first;
    while (line <= last) {
        start = byte_at_line(line, 0);
        at = start;
        raw = body->c_str();
        n = body->size();
        while (at < n) {
            value = byte_at(raw, at);
            if (value != ' ' && value != '\t')
                break;
            at = at + 1;
        }
        if (at < n && raw[at] != '\n') {
            if (at + lead > n
                    || text_same(
                            slice_text(raw, at, at + lead)
                                    ->c_str(),
                            leader) == 0)
                all = 0;
        }
        line = line + 1;
    }
    push_undo();
    next = new String();
    raw = body->c_str();
    n = body->size();
    line = 0;
    start = 0;
    while (start < n || line <= last) {
        long rowEnd;

        if (start > n)
            break;
        rowEnd = start;
        while (rowEnd < n && raw[rowEnd] != '\n')
            rowEnd = rowEnd + 1;
        if (line >= first && line <= last) {
            at = start;
            while (at < rowEnd) {
                value = byte_at(raw, at);
                if (value != ' ' && value != '\t')
                    break;
                at = at + 1;
            }
            if (all == 1) {
                append_range(next, raw, start, at);
                if (at + lead <= rowEnd
                        && text_starts(raw + at, leader) == 1) {
                    keep = at + lead;
                    if (keep < rowEnd && raw[keep] == ' ')
                        keep = keep + 1;
                    append_range(next, raw, keep, rowEnd);
                }
                else
                    append_range(next, raw, at, rowEnd);
            }
            else {
                append_range(next, raw, start, at);
                next->append(leader);
                next->add(' ');
                append_range(next, raw, at, rowEnd);
            }
        }
        else
            append_range(next, raw, start, rowEnd);
        if (rowEnd < n && raw[rowEnd] == '\n') {
            next->add('\n');
            start = rowEnd + 1;
        }
        else
            start = rowEnd + 1;
        line = line + 1;
        if (start >= n && line > last)
            break;
    }
    body = next;
    dirtyFlag = true;
    hasMatch = false;
    clamp_point();
}

void EditBuffer::toggle_block_comment(void) {
    long lo;
    long hi;
    String *inner;
    const char *raw;

    if (has_selection() == false) {
        push_undo();
        splice(cursor, cursor, "/*  */");
        cursor = cursor - 3;
        anchor = cursor;
        return;
    }
    lo = sel_lo();
    hi = sel_hi();
    raw = body->c_str();
    if (hi - lo >= 4
            && raw[lo] == '/'
            && raw[lo + 1] == '*'
            && raw[hi - 2] == '*'
            && raw[hi - 1] == '/') {
        push_undo();
        inner = slice_text(raw, lo + 2, hi - 2);
        splice(lo, hi, inner->c_str());
        cursor = lo + inner->size();
        anchor = lo;
        return;
    }
    push_undo();
    inner = new String();
    inner->append("/*");
    inner->append(slice_text(raw, lo, hi));
    inner->append("*/");
    splice(lo, hi, inner->c_str());
    anchor = lo;
    cursor = lo + inner->size();
}

int EditBuffer::leading_indent(long lineStart, long *indentEnd) {
    long at;
    long n;
    int value;
    int spaces;
    int tabs;

    at = lineStart;
    n = body->size();
    spaces = 0;
    tabs = 0;
    while (at < n) {
        value = byte_at(body->c_str(), at);
        if (value == ' ')
            spaces = spaces + 1;
        else if (value == '\t')
            tabs = tabs + 1;
        else
            break;
        at = at + 1;
    }
    if (indentEnd != nullptr)
        *indentEnd = at;
    if (tabs > 0 && spaces == 0)
        return 1;
    return 0;
}

void EditBuffer::indent_lines(long width, bool spaces) {
    long first;
    long last;
    long line;
    String *next;
    String *pad;
    const char *raw;
    long n;
    long start;
    long i;
    char ch;

    if (width < 1)
        width = 1;
    if (has_selection() == false) {
        pad = new String();
        if (spaces == true) {
            i = 0;
            while (i < width) {
                pad->add(' ');
                i = i + 1;
            }
        }
        else
            pad->add('\t');
        insert_text(pad->c_str());
        return;
    }
    line_range(&first, &last);
    pad = new String();
    if (spaces == true) {
        i = 0;
        while (i < width) {
            pad->add(' ');
            i = i + 1;
        }
    }
    else
        pad->add('\t');
    push_undo();
    next = new String();
    raw = body->c_str();
    n = body->size();
    line = 0;
    start = 0;
    while (start <= n) {
        long rowEnd;

        rowEnd = start;
        while (rowEnd < n && raw[rowEnd] != '\n')
            rowEnd = rowEnd + 1;
        if (line >= first && line <= last)
            next->append(pad);
        append_range(next, raw, start, rowEnd);
        if (rowEnd < n && raw[rowEnd] == '\n') {
            next->add('\n');
            start = rowEnd + 1;
        }
        else {
            start = n + 1;
        }
        line = line + 1;
        if (start >= n)
            break;
    }
    (void)ch;
    body = next;
    dirtyFlag = true;
    hasMatch = false;
    clamp_point();
}

void EditBuffer::outdent_lines(long width, bool spaces) {
    long first;
    long last;
    long line;
    String *next;
    const char *raw;
    long n;
    long start;

    if (width < 1)
        width = 1;
    line_range(&first, &last);
    push_undo();
    next = new String();
    raw = body->c_str();
    n = body->size();
    line = 0;
    start = 0;
    while (start <= n) {
        long rowEnd;
        long at;
        long drop;
        long seen;

        rowEnd = start;
        while (rowEnd < n && raw[rowEnd] != '\n')
            rowEnd = rowEnd + 1;
        at = start;
        if (line >= first && line <= last) {
            if (spaces == true) {
                seen = 0;
                while (at < rowEnd
                        && raw[at] == ' '
                        && seen < width) {
                    at = at + 1;
                    seen = seen + 1;
                }
            }
            else if (at < rowEnd && raw[at] == '\t')
                at = at + 1;
            else {
                drop = 0;
                while (at < rowEnd
                        && raw[at] == ' '
                        && drop < width) {
                    at = at + 1;
                    drop = drop + 1;
                }
            }
        }
        append_range(next, raw, at, rowEnd);
        if (rowEnd < n && raw[rowEnd] == '\n') {
            next->add('\n');
            start = rowEnd + 1;
        }
        else
            start = n + 1;
        line = line + 1;
        if (start >= n)
            break;
    }
    body = next;
    dirtyFlag = true;
    hasMatch = false;
    clamp_point();
}

void EditBuffer::insert_column(const char *value) {
    long first;
    long last;
    long column;
    long line;
    long at;
    long ignore;

    if (value == nullptr)
        return;
    line_column_at(sel_lo(), &first, &column);
    line_column_at(sel_hi(), &last, &ignore);
    if (last < first) {
        ignore = first;
        first = last;
        last = ignore;
    }
    push_undo();
    line = last;
    while (line >= first) {
        at = byte_at_line(line, column);
        splice(at, at, value);
        line = line - 1;
    }
    cursor = byte_at_line(first, column) + text_length(value);
    anchor = cursor;
}

void EditBuffer::delete_column(void) {
    long first;
    long last;
    long column;
    long line;
    long at;
    long ignore;
    long n;
    int value;
    int step;

    line_column_at(sel_lo(), &first, &column);
    line_column_at(sel_hi(), &last, &ignore);
    if (has_selection() == false) {
        first = cursor_line() - 1;
        last = first;
        column = cursor_column() - 1;
    }
    if (last < first) {
        ignore = first;
        first = last;
        last = ignore;
    }
    push_undo();
    line = last;
    while (line >= first) {
        at = byte_at_line(line, column);
        n = body->size();
        if (at < n && body->c_str()[at] != '\n') {
            value = byte_at(body->c_str(), at);
            step = utf8_len(value);
            if (at + step > n)
                step = 1;
            if (body->c_str()[at] != '\n')
                splice(at, at + step, "");
        }
        line = line - 1;
    }
    cursor = byte_at_line(first, column);
    anchor = cursor;
}

int EditBuffer::match_at(
        long index,
        const char *query,
        bool matchCase,
        bool whole) {
    long qn;
    long n;
    long i;
    int left;
    int right;
    const char *raw;

    if (query == nullptr)
        return 0;
    qn = text_length(query);
    n = body->size();
    if (qn == 0 || index < 0 || index + qn > n)
        return 0;
    raw = body->c_str();
    i = 0;
    while (i < qn) {
        left = byte_at(raw, index + i);
        right = byte_at(query, i);
        if (matchCase == false) {
            left = ascii_lower(left);
            right = ascii_lower(right);
        }
        if (left != right)
            return 0;
        i = i + 1;
    }
    if (whole == true) {
        if (index > 0 && is_ident(byte_at(raw, index - 1)) == 1)
            return 0;
        if (index + qn < n
                && is_ident(byte_at(raw, index + qn)) == 1)
            return 0;
    }
    return 1;
}

long EditBuffer::find_from(
        long from,
        long limit,
        const char *query,
        bool matchCase,
        bool whole) {
    long i;

    if (from < 0)
        from = 0;
    i = from;
    while (i < limit) {
        if (match_at(i, query, matchCase, whole) == 1)
            return i;
        i = i + 1;
    }
    return -1;
}

int EditBuffer::find_next(
        const char *query,
        bool matchCase,
        bool whole,
        bool inSel) {
    long begin;
    long end;
    long from;
    long at;
    long qn;

    if (query == nullptr || query[0] == 0)
        return 0;
    begin = 0;
    end = body->size();
    if (inSel == true) {
        if (scopeOn == false)
            return -1;
        begin = scopeStart;
        end = scopeEnd;
    }
    from = sel_hi();
    if (from < begin)
        from = begin;
    if (from > end)
        from = end;
    at = find_from(from, end, query, matchCase, whole);
    if (at < 0 && from > begin)
        at = find_from(begin, from, query, matchCase, whole);
    if (at < 0)
        return 0;
    qn = text_length(query);
    anchor = at;
    cursor = at + qn;
    matchStart = anchor;
    matchEnd = cursor;
    hasMatch = true;
    return 1;
}

void EditBuffer::replace_span(
        long from,
        long to,
        const char *repl) {
    if (repl == nullptr)
        repl = "";
    splice(from, to, repl);
    cursor = from + text_length(repl);
    anchor = cursor;
}

int EditBuffer::replace_next(
        const char *query,
        const char *repl,
        bool matchCase,
        bool whole,
        bool inSel) {
    long lo;
    long hi;
    int found;

    if (query == nullptr || query[0] == 0)
        return 0;
    if (inSel == true && scopeOn == false)
        return -1;
    lo = sel_lo();
    hi = sel_hi();
    if (has_selection() == true
            && hi - lo == text_length(query)
            && match_at(lo, query, matchCase, whole) == 1) {
        push_undo();
        replace_span(lo, hi, repl);
        return 1;
    }
    found = find_next(query, matchCase, whole, inSel);
    if (found != 1)
        return found;
    push_undo();
    replace_span(sel_lo(), sel_hi(), repl);
    return 1;
}

int EditBuffer::replace_all(
        const char *query,
        const char *repl,
        bool matchCase,
        bool whole,
        bool inSel) {
    long begin;
    long end;
    long at;
    long qn;
    long rn;
    int count;
    String *next;
    const char *raw;
    long cursorAt;

    if (query == nullptr || query[0] == 0)
        return 0;
    if (inSel == true && scopeOn == false)
        return -1;
    if (repl == nullptr)
        repl = "";
    begin = 0;
    end = body->size();
    if (inSel == true) {
        begin = scopeStart;
        end = scopeEnd;
    }
    qn = text_length(query);
    rn = text_length(repl);
    count = 0;
    at = begin;
    while (at < end) {
        if (match_at(at, query, matchCase, whole) == 1) {
            count = count + 1;
            at = at + qn;
        }
        else
            at = at + 1;
    }
    if (count == 0)
        return 0;
    push_undo();
    next = new String();
    raw = body->c_str();
    append_range(next, raw, 0, begin);
    at = begin;
    while (at < end) {
        if (match_at(at, query, matchCase, whole) == 1) {
            next->append(repl);
            at = at + qn;
        }
        else {
            next->add(raw[at]);
            at = at + 1;
        }
    }
    append_range(next, raw, end, body->size());
    cursorAt = begin;
    body = next;
    dirtyFlag = true;
    hasMatch = false;
    if (scopeOn == true)
        scopeEnd = scopeStart + (end - begin) + (rn - qn) * count;
    cursor = cursorAt;
    anchor = cursor;
    clamp_point();
    return count;
}

void EditBuffer::capture_scope(void) {
    if (has_selection() == false) {
        scopeOn = false;
        return;
    }
    if (hasMatch == true
            && sel_lo() == matchStart
            && sel_hi() == matchEnd)
        return;
    scopeOn = true;
    scopeStart = sel_lo();
    scopeEnd = sel_hi();
}

void EditBuffer::clear_scope(void) {
    scopeOn = false;
}

bool EditBuffer::scope_active(void) {
    return scopeOn;
}

void EditBuffer::set_auto_brackets(bool value) {
    brackets = value;
}

void EditBuffer::set_auto_indent(bool value) {
    indentOn = value;
}

bool EditBuffer::auto_brackets(void) {
    return brackets;
}

bool EditBuffer::auto_indent(void) {
    return indentOn;
}

bool EditBuffer::selection_one_line(void) {
    long line;
    long column;
    long line2;
    long column2;

    if (has_selection() == false)
        return false;
    line_column_at(sel_lo(), &line, &column);
    line_column_at(sel_hi(), &line2, &column2);
    if (line == line2)
        return true;
    return false;
}

int EditBuffer::note_external(const char *value) {
    const char *oldRaw;
    String *oldCopy;
    long oldN;
    long newN;
    long prefix;
    long oldEnd;
    long newEnd;
    long delta;
    int extra;

    if (value == nullptr)
        value = "";
    if (text_same(body->c_str(), value) == 1)
        return 0;
    oldCopy = new String(body);
    oldRaw = oldCopy->c_str();
    oldN = oldCopy->size();
    newN = text_length(value);
    prefix = 0;
    while (prefix < oldN
            && prefix < newN
            && oldRaw[prefix] == value[prefix])
        prefix = prefix + 1;
    oldEnd = oldN;
    newEnd = newN;
    while (oldEnd > prefix
            && newEnd > prefix
            && oldRaw[oldEnd - 1] == value[newEnd - 1]) {
        oldEnd = oldEnd - 1;
        newEnd = newEnd - 1;
    }
    push_undo();
    assign(value);
    delta = (newEnd - prefix) - (oldEnd - prefix);
    cursor = prefix + (newEnd - prefix);
    anchor = cursor;
    dirtyFlag = true;
    shift_scope(prefix, delta);
    extra = 0;
    finish_brackets(
            prefix,
            newEnd - prefix,
            oldEnd - prefix,
            oldRaw,
            oldEnd > prefix ? prefix : oldEnd,
            oldEnd);
    if (text_same(body->c_str(), value) == 0)
        extra = 1;
    return extra;
}

#endif
